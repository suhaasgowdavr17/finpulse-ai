# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCALLY@localhost:5432/complygem
SQL_ECHO=false

# Required shared secret for callbacks to the backend
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
BACKEND_URL=http://localhost:5000

# Optional Google Gemini integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004

# Optional Firebase integration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Development mode and local vector index
DEMO_MODE=true
FAISS_INDEX_PATH=./data/faiss_index
